{
	"schemaVersion": 1,
	"id": "spellgems",
	"version": "${version}",
	"name": "Spellgems",
	"description": "Spellgems - spell gems, wands, and enchanting for Minecraft.",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/spellgems/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.pnovaczek.spellgems.SpellgemsFabric"
		],
		"client": [
			"net.pnovaczek.spellgems.client.SpellgemsClient"
		],
		"fabric-datagen": [
			"net.pnovaczek.spellgems.client.SpellgemsDataGenerator"
		],
		"jei_mod_plugin": [
			"net.pnovaczek.spellgems.client.jei.SpellgemsJeiPlugin"
		]
	},
	"mixins": [
		"spellgems.mixins.json",
		"spellgems.fabric.mixins.json",
		{
			"config": "spellgems.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.1",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
